{
  "name": "@releaselens/core",
  "version": "0.0.0",
  "description": "Config schema, types, and check runner for releaselens.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "typescript": "5.9.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "tsup": "8.5.1",
    "vitest": "3.2.4"
  }
}
