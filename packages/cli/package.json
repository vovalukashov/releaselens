{
  "name": "releaselens",
  "version": "0.1.4",
  "description": "Pre-merge contract checks for Next.js App Router marketing sites: SEO metadata, locales, Payload CMS.",
  "license": "MIT",
  "keywords": [
    "nextjs",
    "ci",
    "seo",
    "regression",
    "release-safety",
    "cli"
  ],
  "homepage": "https://github.com/vovalukashov/releaselens#readme",
  "bugs": "https://github.com/vovalukashov/releaselens/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vovalukashov/releaselens.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "releaselens": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo",
    "prepublishOnly": "tsup"
  },
  "dependencies": {
    "@releaselens/core": "workspace:*",
    "commander": "13.1.0",
    "jiti": "2.7.0",
    "picocolors": "1.1.1"
  },
  "devDependencies": {
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
