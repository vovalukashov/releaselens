{
  "name": "site-doctor",
  "version": "0.0.0",
  "description": "Release-safety checks for code-first Next.js marketing sites.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "site-doctor": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@site-doctor/core": "workspace:*",
    "commander": "13.1.0",
    "jiti": "2.7.0",
    "picocolors": "1.1.1"
  },
  "devDependencies": {
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
