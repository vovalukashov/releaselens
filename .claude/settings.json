{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git log *)",
      "Bash(git status)",
      "Bash(git show *)",
      "Bash(git blame *)",
      "Bash(git diff *)",
      "Bash(git stash list)",
      "Bash(pnpm -w build)",
      "Bash(pnpm -w test)",
      "Bash(pnpm -w typecheck)",
      "Bash(pnpm -w lint)",
      "Bash(pnpm --filter * build)",
      "Bash(pnpm --filter * test *)",
      "Bash(pnpm --filter * typecheck)",
      "Bash(pnpm --filter * lint)",
      "Bash(pnpm -r build)",
      "Bash(pnpm -r test)",
      "Bash(turbo run *)",
      "Bash(npx tsc *)",
      "Bash(npx eslint *)",
      "Bash(npx prettier *)",
      "Bash(npx vitest *)",
      "Bash(npx tsup *)",
      "Bash(npx tsx *)",
      "Bash(vitest run *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*secret*)",
      "Read(**/*token*)",
      "Read(**/.snowsql/**)",
      "Read(**/.snowflake/**)",
      "Read(**/.ssh/**)",
      "Read(**/.aws/**)",
      "Read(**/.git/config)",
      "Read(**/config/cred/**)",
      "Edit(**/.env)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(**/*secret*)",
      "Edit(**/*token*)",
      "Edit(**/config/cred/**)",
      "Write(**/.env)",
      "Write(**/*.pem)",
      "Write(**/*.key)",
      "Write(**/*secret*)",
      "Write(**/*token*)",
      "Write(**/config/cred/**)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(nc *)",
      "Bash(ssh *)",
      "Bash(scp *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git commit *)",
      "Bash(git rebase *)",
      "Bash(git merge *)",
      "Bash(git checkout *)",
      "Bash(git branch -D *)",
      "Bash(pnpm install *)",
      "Bash(pnpm add *)",
      "Bash(pnpm remove *)",
      "Bash(pnpm update *)",
      "Bash(pnpm publish *)",
      "Bash(pnpm -r publish *)",
      "Bash(pnpm -w dev)",
      "Bash(pnpm dev)",
      "Bash(pnpm -w start)",
      "Bash(pnpm start)",
      "Bash(docker *)"
    ]
  }
}
